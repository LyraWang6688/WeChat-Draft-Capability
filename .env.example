# Current Publisher runtime (Single Repo -> GitHub Actions -> WeChat Draft)
PORT=3010
LOG_LEVEL=info
# Server-only: fine-grained PAT, canonical repository Contents Read-only
GITHUB_CONTENT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# API authentication; same token configured in GitHub Actions secrets
PUBLISHER_WEBHOOK_TOKEN=
# DELIVERY_STATE ledger, never a disposable cache
PUBLISHER_STATE_FILE=.data/publisher-state.json
PUBLISHER_ALLOWED_REPOSITORIES=LyraWang6688/wechat-draft-capability
GITHUB_API_TIMEOUT_MS=30000
WECHAT_API_TIMEOUT_MS=120000
# Workflow-only secrets (configure in GitHub, not used by src/config.ts):
# PUBLISHER_ENDPOINT, PUBLISHER_WEBHOOK_TOKEN
