PORT=3010
LARK_CLI_BIN=lark-cli
LARK_CLI_TIMEOUT_MS=120000
DEFAULT_BASE_TOKEN=
DEFAULT_TABLE_ID=
LOG_LEVEL=info
LOG_CLI_STDOUT=true
LOG_CLI_STDOUT_MAX_CHARS=4000
LOG_CLI_STDERR_MAX_CHARS=4000
WECHAT_API_TIMEOUT_MS=120000
# ---- Publisher API (GitHub Content Hub -> 微信草稿) ----
# GitHub Content Hub 私有仓库只读 Token（Fine-grained PAT，仅 Contents Read-only）
GITHUB_CONTENT_TOKEN=
# 单公众号 MVP：微信公众号凭证（服务器端持有，禁止写入 Git / 返回客户端 / 写入日志）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Publisher API 鉴权 Token（GitHub Actions 只持有此值）
PUBLISHER_WEBHOOK_TOKEN=
# 幂等状态持久化文件（默认 .data/publisher-state.json）
PUBLISHER_STATE_FILE=.data/publisher-state.json
# Content Repository 白名单（逗号分隔，Publisher 只允许读取这些仓库）
PUBLISHER_ALLOWED_REPOSITORIES=LyraWang6688/yaai-content-hub
GITHUB_API_TIMEOUT_MS=30000

# ---- 本地 stdio MCP：微信公众号草稿通道 ----
# 仅本机使用，不要提交到 Git。MCP 客户端可通过本文件或 env 读取。
# （WECHAT_APP_ID / WECHAT_APP_SECRET 见上方 Publisher API 段，两通道共用同一对凭证）
# 可选：未在 meta.json / 工具参数中指定 author 时的默认作者
WECHAT_DEFAULT_AUTHOR=
# 微信 API 基地址（仅本地联调/测试替身用，生产保持默认）
WECHAT_API_BASE=https://api.weixin.qq.com
# MCP stdio 模式下强制日志走 stderr（默认由 src/mcp/main.ts 自动设置）
MCP_LOG_TARGET=stderr

# 微信 draft/add 官方字段上限（一般不需要改）
#   title  <= 32 字
#   author <= 16 字
#   digest <= 120 字
#   content: 不可超过 2kb，且少于 2 万字符、小于 1M
# 若实测你的账号接受更大正文，可放开 WECHAT_CONTENT_MAX_BYTES。
WECHAT_TITLE_MAX_CHARS=32
WECHAT_AUTHOR_MAX_CHARS=16
WECHAT_DIGEST_MAX_CHARS=120
WECHAT_CONTENT_MAX_CHARS=20000
WECHAT_CONTENT_MAX_BYTES=2048
